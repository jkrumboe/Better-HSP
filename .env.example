# .env.example – kopiere diese Datei nach .env und passe sie an.
# ALLE Werte sind optional: fehlen SESSION_SECRET / TOKEN_ENCRYPTION_KEY,
# werden sie beim ersten Start einmalig erzeugt und in data/.secrets.json abgelegt.

# Öffentliche URL der App (für den SSO-Rücksprung), OHNE abschließenden Slash.
# Muss exakt der Adresse entsprechen, unter der der Nginx Proxy Manager die App ausliefert.
PUBLIC_URL=https://betterhsp.deine-domain.de

# Secure-Cookies (nur über HTTPS senden). Hinter dem HTTPS-Proxy: true.
# Für reinen localhost-Test ohne HTTPS: false.
COOKIE_SECURE=true

# Zeitzone für geplante Buchungen
TZ=Europe/Berlin

# --- Optional: Secrets fest vorgeben (sonst Auto-Generierung) ---
# 48+ zufällige Zeichen. Erzeugen z.B.: openssl rand -hex 48
SESSION_SECRET=

# Genau 32 Byte als 64 Hex-Zeichen. Erzeugen z.B.: openssl rand -hex 32
# ACHTUNG: Wird dieser Key geändert, sind bereits verschlüsselte HSP-Tokens
# nicht mehr lesbar – betroffene Nutzer müssen sich dann neu via SSO anmelden.
TOKEN_ENCRYPTION_KEY=
